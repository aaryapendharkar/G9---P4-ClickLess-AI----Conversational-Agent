@prefix cc:   <https://example.org/clickless#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Minimal domain ontology v0.1 (proposal §III-C). Owner: Manas.
# TODO(Manas): replace example.org namespace; align Claim/Source with PROV-O; add competency
# questions in docs/COMPETENCY_QUESTIONS.md and make sure each is answerable.

cc:Station       a owl:Class .
cc:ChargingPort  a owl:Class .
cc:Network       a owl:Class .
cc:Connector     a owl:Class .
cc:Vehicle       a owl:Class .
cc:Amenity       a owl:Class .
cc:Claim         a owl:Class .
cc:Source        a owl:Class ; rdfs:subClassOf prov:Entity .

cc:hasPort      a owl:ObjectProperty ; rdfs:domain cc:Station      ; rdfs:range cc:ChargingPort .
cc:hasConnector a owl:ObjectProperty ; rdfs:domain cc:ChargingPort ; rdfs:range cc:Connector .
cc:operatedBy   a owl:ObjectProperty ; rdfs:domain cc:Station      ; rdfs:range cc:Network .
cc:supports     a owl:ObjectProperty ; rdfs:domain cc:Vehicle      ; rdfs:range cc:Connector .
cc:supportsViaAdapter a owl:ObjectProperty ; rdfs:subPropertyOf cc:supports .
cc:near         a owl:ObjectProperty ; rdfs:domain cc:Station      ; rdfs:range cc:Amenity .
cc:supportedBy  a owl:ObjectProperty ; rdfs:domain cc:Claim        ; rdfs:range cc:Source .

cc:powerKw       a owl:DatatypeProperty ; rdfs:domain cc:ChargingPort ; rdfs:range xsd:decimal .
cc:portCount     a owl:DatatypeProperty ; rdfs:domain cc:ChargingPort ; rdfs:range xsd:integer .
cc:distanceM     a owl:DatatypeProperty .
cc:wheelchair    a owl:DatatypeProperty ; rdfs:domain cc:Amenity ; rdfs:range xsd:string .
cc:status        a owl:DatatypeProperty ; rdfs:domain cc:Station ; rdfs:range xsd:string .
cc:retrievedAt   a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
cc:sourceUpdatedAt a owl:DatatypeProperty ; rdfs:range xsd:dateTime .

cc:CCS1    a cc:Connector .
cc:NACS    a cc:Connector .
cc:CHADEMO a cc:Connector .
cc:J1772   a cc:Connector .
