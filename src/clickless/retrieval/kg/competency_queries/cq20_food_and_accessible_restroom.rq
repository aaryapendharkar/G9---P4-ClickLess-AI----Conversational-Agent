# CQ20: Which stations have both a food place and a wheelchair-accessible restroom within 400 m?
# Author: Aarya (#158). The combined stop the benchmark's accessibility items ask for. Only an
# explicit wheelchair=yes counts (an untagged restroom is unknown, never accessible; ADR 0011).
PREFIX cc: <https://example.org/clickless#>

SELECT ?station ?food ?restroom
WHERE {
  ?station  cc:near ?food , ?restroom .
  ?food     cc:amenityCategory "food" .
  ?restroom cc:amenityCategory "restroom" ;
            cc:wheelchair      "yes" .
}
ORDER BY ?station ?food ?restroom
