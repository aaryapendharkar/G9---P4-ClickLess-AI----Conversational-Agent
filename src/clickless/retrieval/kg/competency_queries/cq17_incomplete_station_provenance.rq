# CQ17: Which station records lack a source record id or a source URL, so a claim about them
#       cannot be traced back to the source record?
# Author: Aarya (#158). Snapshot stations carry the AFDC record id and URL; synthetic or
# hand-made records may not. One row per station with at least one missing; the two flags say which.
PREFIX cc: <https://example.org/clickless#>

SELECT ?station ?sourceName ?missingRecordId ?missingUrl
WHERE {
  ?station a cc:Station ;
           cc:hasProvenance ?source .
  ?source  cc:sourceName ?sourceName .
  BIND (NOT EXISTS { ?source cc:sourceRecordId ?anyId } AS ?missingRecordId)
  BIND (NOT EXISTS { ?source cc:sourceUrl ?anyUrl } AS ?missingUrl)
  FILTER (?missingRecordId || ?missingUrl)
}
ORDER BY ?station
