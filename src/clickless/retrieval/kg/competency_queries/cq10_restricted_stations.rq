# CQ10: Which stations are not open to the public, and what access does the source give?
# Author: Aarya (#158, on Manas's behalf). Every station has cc:access ("public" or "restricted",
# Station.access); planning never routes to a restricted one (planning/filters.py).
PREFIX cc:   <https://example.org/clickless#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?station ?name ?access
WHERE {
  ?station a cc:Station ;
           rdfs:label ?name ;
           cc:access  ?access .
  FILTER (?access != "public")
}
ORDER BY ?station
