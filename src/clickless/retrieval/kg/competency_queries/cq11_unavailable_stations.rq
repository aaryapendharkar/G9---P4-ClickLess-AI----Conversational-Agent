# CQ11: Which stations does the source not report as available, and with which status?
# Author: Aarya (#158). cc:status is Station.status: available, planned, temporarily_unavailable
# or unknown. Planned and temporarily unavailable stations are never planned through; unknown is
# allowed but reported (unknown_status_reliance in the evaluation).
PREFIX cc: <https://w3id.org/clickless#>

SELECT ?station ?status
WHERE {
  ?station a cc:Station ;
           cc:status ?status .
  FILTER (?status != "available")
}
ORDER BY ?status ?station
